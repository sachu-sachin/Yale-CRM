generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TELECALLER)
  phone     String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  targets          Target[]
  activityLogs     ActivityLog[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  announcements    Announcement[] @relation("AnnouncementAuthor")
  clients          Client[]         @relation("ClientCreatedBy")
  createdAds       Ad[]             @relation("AdCreatedBy")
  assignedAds      Ad[]             @relation("AdAssignedTo")
  notifications    Notification[]
  stageChanges     DealStageEvent[] @relation("StageChanges")
}

enum Role {
  ADMIN
  TELECALLER
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WALKIN
  REFERRAL
  GOOGLE_ADS
  OTHER
}

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  city        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("ClientCreatedBy", fields: [createdById], references: [id])
  ads       Ad[]
}

// "Ad" is the unified Deal: every enquiry/deal is one of these.
model Ad {
  id              String     @id @default(cuid())
  clientId        String
  title           String
  amount          Float      @default(0)
  status          DealStatus @default(NOT_CLOSED)
  source          LeadSource @default(OTHER)
  serviceInterest String[]
  budgetRange     String?
  city            String?
  phase           AdPhase?
  seq             Int?
  closeDate       DateTime   @default(now())
  endDate         DateTime?
  durationDays    Int?
  reminderDate    DateTime?
  renewedAt       DateTime?
  supersededById  String?
  notes           String?
  assignedToId    String?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("AdAssignedTo", fields: [assignedToId], references: [id])
  createdBy    User             @relation("AdCreatedBy", fields: [createdById], references: [id])
  supersededBy Ad?              @relation("AdRenewal", fields: [supersededById], references: [id], onDelete: SetNull)
  renewals     Ad[]             @relation("AdRenewal")
  stageEvents  DealStageEvent[]

  @@index([clientId])
  @@index([status])
  @@index([phase])
}

model DealStageEvent {
  id          String      @id @default(cuid())
  adId        String
  fromStatus  DealStatus?
  toStatus    DealStatus
  changedById String
  createdAt   DateTime    @default(now())

  ad        Ad   @relation(fields: [adId], references: [id], onDelete: Cascade)
  changedBy User @relation("StageChanges", fields: [changedById], references: [id])

  @@index([adId])
}

enum DealStatus {
  PAID // Conversion / Paid
  PENDING // Waiting for payment
  FOLLOW_UP // Follow-up
  NOT_CLOSED // Not closed
  REPEATED // Repeated lead (shows notes)
  IRRELEVANT
}

enum AdPhase {
  CLOSED
  RENEWAL
  REGULAR
}

model Target {
  id             String   @id @default(cuid())
  telecallerId   String
  month          Int
  year           Int
  targetLeads    Int      @default(0)
  targetConverts Int      @default(0)
  bonusAmount    Float    @default(0.0)
  achievedBonus  Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  telecaller User @relation(fields: [telecallerId], references: [id])

  @@unique([telecallerId, month, year])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType @default(GENERAL)
  title     String
  body      String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead])
}

enum NotificationType {
  GENERAL
  MESSAGE
  DEAL_ENDING
  REMINDER
  DEAL
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
