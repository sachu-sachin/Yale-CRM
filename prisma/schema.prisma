generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  role      Role     @default(TELECALLER)
  phone     String?
  isActive  Boolean  @default(true)
  createdBy String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  assignedLeads    Lead[]         @relation("AssignedTo")
  createdLeads     Lead[]         @relation("CreatedBy")
  callLogs         CallLog[]
  targets          Target[]
  activityLogs     ActivityLog[]
  sentMessages     Message[]      @relation("SentMessages")
  receivedMessages Message[]      @relation("ReceivedMessages")
  announcements    Announcement[] @relation("AnnouncementAuthor")
  clients          Client[]       @relation("ClientCreatedBy")
  createdAds       Ad[]           @relation("AdCreatedBy")
  assignedAds      Ad[]           @relation("AdAssignedTo")
}

enum Role {
  ADMIN
  TELECALLER
}

model Lead {
  id              String     @id @default(cuid())
  name            String
  email           String?
  phone           String
  altPhone        String?
  source          LeadSource
  serviceInterest String[]
  city            String?
  budgetRange     String?
  status          LeadStatus @default(NEW_ENQUIRY)
  notes           String?
  assignedToId    String?
  createdById     String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  assignedTo User?     @relation("AssignedTo", fields: [assignedToId], references: [id])
  createdBy  User      @relation("CreatedBy", fields: [createdById], references: [id])
  callLogs   CallLog[]
  ads        Ad[]
}

enum LeadSource {
  WEBSITE
  WHATSAPP
  FACEBOOK
  INSTAGRAM
  WALKIN
  REFERRAL
  GOOGLE_ADS
  OTHER
}

enum LeadStatus {
  NEW_ENQUIRY
  CONTACTED
  FOLLOW_UP
  PROPOSAL_SENT
  WON
  LOST
}

model Client {
  id          String   @id @default(cuid())
  name        String
  phone       String   @unique
  email       String?
  city        String?
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  createdBy User @relation("ClientCreatedBy", fields: [createdById], references: [id])
  ads       Ad[]
}

model Ad {
  id            String        @id @default(cuid())
  clientId      String
  leadId        String?
  title         String
  amount        Float         @default(0)
  paymentStatus PaymentStatus @default(PENDING)
  phase         AdPhase       @default(CLOSED)
  seq           Int           @default(1)
  closeDate     DateTime      @default(now())
  endDate       DateTime
  durationDays  Int?
  notes         String?
  assignedToId  String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  client     Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  lead       Lead?  @relation(fields: [leadId], references: [id])
  assignedTo User?  @relation("AdAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User   @relation("AdCreatedBy", fields: [createdById], references: [id])

  @@index([clientId])
  @@index([phase])
}

enum PaymentStatus {
  PENDING
  PARTIAL
  PAID
}

enum AdPhase {
  CLOSED
  RENEWAL
  REGULAR
}

model CallLog {
  id           String      @id @default(cuid())
  leadId       String
  telecallerId String
  callDate     DateTime    @default(now())
  duration     Int?
  outcome      CallOutcome
  notes        String?
  followUpDate DateTime?
  createdAt    DateTime    @default(now())

  lead       Lead @relation(fields: [leadId], references: [id])
  telecaller User @relation(fields: [telecallerId], references: [id])
}

enum CallOutcome {
  INTERESTED
  NOT_INTERESTED
  CALLBACK
  NO_ANSWER
  WRONG_NUMBER
  CONVERTED
}

model Target {
  id             String   @id @default(cuid())
  telecallerId   String
  month          Int
  year           Int
  targetCalls    Int      @default(0)
  targetConverts Int      @default(0)
  bonusAmount    Float    @default(0.0)
  achievedBonus  Boolean  @default(false)
  createdBy      String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  telecaller User @relation(fields: [telecallerId], references: [id])

  @@unique([telecallerId, month, year])
}

model Message {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  content    String
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id])
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id])
}

model Announcement {
  id          String   @id @default(cuid())
  title       String
  content     String
  createdById String
  createdAt   DateTime @default(now())

  createdBy User @relation("AnnouncementAuthor", fields: [createdById], references: [id])
}

model ActivityLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  entityType String
  entityId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
